# Copy this file to .streamlit/secrets.toml and fill in your API keys
# These are OPTIONAL - the analyzer works without them but with reduced capability

# VirusTotal API key (free tier: 4 requests/min)
# Get yours at: https://www.virustotal.com/gui/join-us
vt_api_key = ""

# AbuseIPDB API key (free tier: 1000 checks/day)
# Get yours at: https://www.abuseipdb.com/register
abuseipdb_key = ""

# MalwareBazaar API key (optional, works without key)
# Register at: https://bazaar.abuse.ch/
malwarebazaar_key = ""
